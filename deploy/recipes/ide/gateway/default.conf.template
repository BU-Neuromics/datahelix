# DataHelix `ide` gateway — single origin for the whole dev stack.
#
# Rendered by the nginx image's envsubst step (/etc/nginx/templates/*.template
# → /etc/nginx/conf.d/) so the upstreams can be swapped per compose profile
# without a second config file.
#
# Routing mirrors `solo` deliberately (deployment-recipes.md decision 1.9):
# Aperture at /, the data plane proxied at /graphql, and the SPA configured
# with a *relative* endpoint — so no CORS configuration exists anywhere.

# Vite's HMR runs over a websocket. `Connection` must be "upgrade" only for
# requests that actually ask for it, and "close" otherwise — hardcoding
# "upgrade" breaks ordinary keep-alive requests.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    # Upstreams are resolved at *request* time via Docker's embedded DNS
    # rather than at startup. With a literal name in proxy_pass, nginx
    # resolves once at boot and exits if the name is missing — which would
    # mean the gateway could not start unless every profile were running.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Generous body size: schema uploads and ingest payloads during dev.
    client_max_body_size 64m;

    # ── Data plane ─────────────────────────────────────────────────────────
    # Only these paths are proxied; Mosaic's full REST surface is not exposed
    # through this port. Publish the mosaic service's 8001 directly if you
    # need raw REST access.
    location /graphql {
        set $mosaic "${MOSAIC_UPSTREAM}";
        proxy_pass http://$mosaic$request_uri;
        proxy_set_header Authorization "Bearer ${MOSAIC_TOKEN}";
        proxy_set_header Host $host;
        # GraphQL responses stream; don't sit on them.
        proxy_buffering off;
    }

    location = /health {
        set $mosaic "${MOSAIC_UPSTREAM}";
        proxy_pass http://$mosaic$request_uri;
    }

    location ~ ^/(docs|redoc|openapi\.json)$ {
        set $mosaic "${MOSAIC_UPSTREAM}";
        proxy_pass http://$mosaic$request_uri;
        proxy_set_header Authorization "Bearer ${MOSAIC_TOKEN}";
        proxy_set_header Host $host;
    }

    # ── Application ────────────────────────────────────────────────────────
    # One block serves both the published-image profile (nginx serving static
    # files) and the source profile (Vite dev server). The websocket upgrade
    # headers are what make HMR work through the gateway; they are inert for
    # the static case, so no per-profile branching is needed.
    #
    # Never cache the runtime config or the HTML shell (Aperture ADR-0034);
    # in the Vite case nothing is cacheable anyway.
    location = /config.js {
        set $aperture "${APERTURE_UPSTREAM}";
        proxy_pass http://$aperture$request_uri;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }

    location / {
        set $aperture "${APERTURE_UPSTREAM}";
        proxy_pass http://$aperture$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # HMR holds the socket open indefinitely; the default 60s read timeout
        # would sever it and silently degrade HMR to nothing.
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
        proxy_buffering off;
    }
}
