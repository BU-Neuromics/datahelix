# Copy to `.env` and edit. Compose reads `.env` from this directory
# automatically, so `make chat-dev` then needs no arguments.
#
# Every path is relative to THIS directory (deploy/recipes/ide/).

# Where the data and schema live. The default (./project) is a scaffolded
# Note/Project toy; point it at a real project to demo real data.
PROJECT_DIR=../../../../mosaic-demo-small

# Source checkouts for the -source profiles. The defaults assume datahelix's
# own submodules (../../../mosaic/src); these point one level further up, at
# sibling clones, which is the usual working layout.
MOSAIC_SRC=../../../../mosaic/src
APERTURE_WEB=../../../../aperture/web
REEL_SRC=../../../../reel/src

# Optional. Unset means the planner uses its default model and your default AWS
# credentials from the mounted ~/.aws.
# REEL_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_PROFILE=
# AWS_REGION=us-east-1
